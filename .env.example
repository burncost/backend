# ============================================
# BUILDING MATERIALS PLATFORM — ENV TEMPLATE
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================
PROJECT_NAME=Building Materials Platform
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=True

# ============================================
# SECURITY — GENERATE A STRONG RANDOM KEY FOR PRODUCTION:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

PORT=8080

# ============================================
# CORS — add the exact production + dev frontend/admin origins
# ============================================
# ALLOWED_ORIGINS=["https://burncost.com","https://www.burncost.com","https://admin.burncost.com","http://localhost:5173","http://localhost:5174"]

# ============================================
# POSTGRESQL DATABASE
# ============================================
DEV_POSTGRES_SERVER=localhost
DEV_POSTGRES_USER=postgres
DEV_POSTGRES_PASSWORD=postgres
DEV_POSTGRES_DB=burncostdb
DEV_POSTGRES_PORT=5432

POSTGRES_SERVER=your-production-db-host
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=burncostdb
POSTGRES_PORT=5432

# ============================================
# MONGODB DATABASE
# ============================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=burncost_db
MONGO_USER=
MONGO_PASSWORD=

# ============================================
# REDIS / UPSTASH
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_EMAIL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# CELERY
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# CLOUD STORAGE
# ============================================
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# ============================================
# PAYMENT GATEWAYS (test keys only in dev)
# ============================================
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
MOCK_PAYMENT_GATEWAY=True

# ============================================
# EMAIL
# ============================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@burncost.com
EMAILS_FROM_NAME=Burncost

# ============================================
# SMS
# ============================================
SMS_PROVIDER=mock
TERMII_API_KEY=

# ============================================
# AI/ML
# ============================================
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_REGISTRATION=True
ENABLE_VENDOR_REGISTRATION=True
ENABLE_PAYMENT_GATEWAY=False
ENABLE_SMS_NOTIFICATIONS=False
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_AI_BOQ_GENERATION=True

BYPASS_EMAIL_VERIFICATION=True
TESTING=True

# ============================================
# DEV TOOLS
# ============================================
LOG_LEVEL=DEBUG
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

API_URL=http://localhost:8000/api/v1
UPLOAD_DIR=./uploads

RESEND_API_KEY=
BREVO_API_KEY=